rules_version = '2';

// Clients only ever touch their own data under users/{uid}.
// Jobs: the app may create a "queued" request; only the Cloud Function moves it on. The owner
// may clear a job once it has finished or failed, or once it is clearly stuck (the function
// times out after 9 minutes).
// Tracks: written by the Cloud Function; the owner may rate or delete them.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The listener's voice nudges: each of pitch/grit/spoken/space is -1, 0 or 1.
    function validTweaks(t) {
      return t is map
        && t.keys().hasOnly(['pitch', 'grit', 'spoken', 'space'])
        && (!('pitch' in t) || t.pitch in [-1, 0, 1])
        && (!('grit' in t) || t.grit in [-1, 0, 1])
        && (!('spoken' in t) || t.spoken in [-1, 0, 1])
        && (!('space' in t) || t.space in [-1, 0, 1]);
    }

    function validJob(d) {
      return d.keys().hasOnly(['stationId', 'mood', 'theme', 'energy', 'vocals', 'singer',
                               'voiceTweaks', 'inspiration', 'lyrics', 'status', 'createdAt'])
        && d.status == 'queued'
        && d.createdAt == request.time
        && d.stationId is string && d.stationId.size() > 0 && d.stationId.size() <= 64
        && (!('mood' in d) || d.mood == null || (d.mood is string && d.mood.size() <= 40))
        && (!('theme' in d) || d.theme == null || (d.theme is string && d.theme.size() <= 200))
        && (!('energy' in d) || d.energy == null
            || (d.energy is number && d.energy >= 0 && d.energy <= 1))
        && (!('vocals' in d) || d.vocals == null || d.vocals is bool)
        && (!('singer' in d) || d.singer == null || d.singer in ['male', 'female'])
        && (!('voiceTweaks' in d) || d.voiceTweaks == null || validTweaks(d.voiceTweaks))
        && (!('inspiration' in d) || d.inspiration == null
            || (d.inspiration is string && d.inspiration.size() <= 80))
        && (!('lyrics' in d) || d.lyrics == null
            || (d.lyrics is string && d.lyrics.size() <= 3000));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /jobs/{jobId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validJob(request.resource.data);
        allow delete: if isOwner(uid)
          && (resource.data.status in ['done', 'failed']
              || request.time > resource.data.createdAt + duration.value(15, 'm'));
        allow update: if false;
      }

      // Voice adjustments the listener saved for an artist ("bob-dylan"), reused next time.
      match /voices/{artistKey} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && artistKey.size() <= 80
          && request.resource.data.keys().hasOnly(['tweaks', 'updatedAt'])
          && validTweaks(request.resource.data.tweaks)
          && request.resource.data.updatedAt == request.time;
      }

      match /tracks/{trackId} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
          && request.resource.data.rating in [-1, 0, 1];
        allow create: if false;
      }
    }
  }
}
